# Alien Clay - Git Ignore Rules

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Editor Files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies (if added later)
node_modules/
vendor/

# Build outputs (if build process added later)
dist/
build/
.cache/

# Environment variables
.env
.env.local
.env.*.local

# Temporary files
tmp/
temp/
*.tmp

# System files
.Spotlight-V100
.Trashes
ehthumbs.db
